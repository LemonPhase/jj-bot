{
  "name": "jj-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others -n api,web,worker -c cyan,green,yellow \"npm run dev -w @jj/api\" \"npm run dev -w @jj/web\" \"npm run dev -w @jj/worker\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "build": "npm run typecheck && npm run build -w @jj/web",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build -w @jj/web",
    "check": "npm run verify",
    "smoke:model": "node --import tsx --env-file=.env scripts/smoke.ts model",
    "smoke:tool": "node --import tsx --env-file=.env scripts/smoke.ts tool",
    "smoke:backend": "node --import tsx --env-file=.env scripts/backend-smoke.ts",
    "smoke:runtime": "node --import tsx --env-file-if-exists=.env scripts/smoke-runtime.ts",
    "sandbox:image": "docker build -t jj-sandbox:base-1 packages/sandbox/images/base"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "24.10.1",
    "concurrently": "10.0.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
