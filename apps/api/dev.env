# Defaults for `npm run dev` only: the root .env and the shell override them.
# Never put a key or a secret here; this file is committed.
JJ_LOG_FORMAT=pretty
# tsx watch kills a process still running 5 s after its SIGTERM, so a reload
# does not drain: it interrupts running sessions at once, and the restarted
# server resumes them (docs/development.md, Stopping and draining).
JJ_DRAIN_TIMEOUT_SEC=0
