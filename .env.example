# Copy to .env at the repository root. Never place model keys in VITE_* variables.
API_HOST=127.0.0.1
API_PORT=3001
AGENT_URL=http://127.0.0.1:3001/api/agent
# Start with docker compose up -d postgres; use pglite for a single-process local alternative.
DATABASE_URL=postgresql://jj:jj_local@localhost:5433/jj_bot
# Server-side only. Without a key the API still stores tasks, but sessions cannot run.
GEMINI_API_KEY=
GEMINI_MODEL=

JJ_DATABASE_MODE=postgres
JJ_DATABASE_PATH=../../.jj-data
JJ_EMBED_WORKER=true
JJ_CONCURRENCY=3
# Set a token before exposing API_HOST beyond loopback.
API_TOKEN=
