# Copy to .env at the repository root. Never place model keys in VITE_* variables.
API_HOST=127.0.0.1
API_PORT=3001
AGENT_URL=http://127.0.0.1:3001/api/agent
# Used only by the database package; the scaffold boots without PostgreSQL.
DATABASE_URL=postgresql://jj:jj_local@localhost:5432/jj_bot
# Agent execution is not implemented yet. A key alone does not enable chat.
GEMINI_API_KEY=
GEMINI_MODEL=
