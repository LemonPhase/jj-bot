[
  {
    "description": "Run a shell command (sh -c) in the task workspace /workspace, which is the working directory of every command. Returns combined stdout and stderr. Output over 64 KiB is truncated to its head and tail, and output past 256 KiB is not kept. Each call starts a fresh shell; files persist, shell state does not. Commands time out after 120 s.",
    "name": "bash",
    "parameters": "{"type":"object","required":["command"],"properties":{"command":{"type":"string","description":"Shell command to run"},"timeout":{"type":"number","description":"Timeout in seconds. At most 120 s, the sandbox's limit."}}}",
  },
