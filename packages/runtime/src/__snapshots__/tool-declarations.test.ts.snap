    "description": "Read a file in the workspace. Text output is limited to 2000 lines or 50 KB; use offset and limit for large files. Images (png, jpeg, gif, webp) are returned as attachments.",
    "name": "read",
    "parameters": "{"type":"object","required":["path"],"properties":{"path":{"type":"string","description":"File path, relative to the workspace or absolute inside it"},"offset":{"type":"number","description":"Line to start at (1-indexed)"},"limit":{"type":"number","description":"Most lines to read"}}}",
  },
  {
    "description": "Edit one file with exact text replacements. Every edits[].oldText must match a unique, non-overlapping region of the original file; merge nearby changes into one edit.",
    "name": "edit",
